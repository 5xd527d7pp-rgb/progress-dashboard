# === 必須 ===
MAGAZINE_LINEAR_API_KEY=lin_api_xxxxx
MAGAZINE_LINEAR_TEAM_KEY=YOUR_TEAM
MAGAZINE_GEMINI_API_KEY=xxxxx
MAGAZINE_SLACK_BOT_TOKEN=xoxb-xxxxx
MAGAZINE_SLACK_CHANNEL_ID=C0XXXXXXXXX
MAGAZINE_SURGE_LOGIN=your-email@example.com
MAGAZINE_SURGE_TOKEN=xxxxx
MAGAZINE_SURGE_DOMAIN=your-project-dashboard.surge.sh

# === オプション ===
# MAGAZINE_GEMINI_MODEL=models/gemini-2.5-flash
# MAGAZINE_SURGE_CDN_WAIT_MS=10000

# === Todoレポート自動配信 ===
# TODO_REPORT_SURGE_DOMAIN=your-todo-report.surge.sh
# TODO_REPORT_SURGE_LOGIN=your-email@example.com
# TODO_REPORT_SURGE_TOKEN=xxxxx
# TODO_REPORT_PUBLIC_URL=https://your-todo-report.surge.sh
# TODO_REPORT_SMTP_HOST=smtp.example.com
# TODO_REPORT_SMTP_PORT=587
# TODO_REPORT_SMTP_USER=mailer@example.com
# TODO_REPORT_SMTP_PASS=xxxxx
# TODO_REPORT_MAIL_FROM=mailer@example.com
# TODO_REPORT_MAIL_TO=team@example.com
# TODO_REPORT_PHONE_LOG_CSV_URL=https://docs.google.com/spreadsheets/d/.../export?format=csv
# TODO_REPORT_FAIL_ON_WARNINGS=0
# 未設定または 1: スプレッドシート（電話ログCSV）のみ集計。メール/打合せを含める場合は 0
# TODO_REPORT_PHONE_ONLY=0
# TODO_REPORT_MAIL_INPUT_DIR=./data/todo-input/mails
# TODO_REPORT_MEETING_INPUT_DIR=./data/todo-input/meeting-docs
# --- Dropbox: 打合せ簿を CI から取得（https://www.dropbox.com/developers/apps でアプリ作成し、アクセストークンを発行）---
# TODO_REPORT_DROPBOX_ACCESS_TOKEN=sl.xxxxx
# 共有フォルダ内のパス（例: /業務/打合せ完成）。未設定なら同期スキップ（手動コピーと同じ）
# TODO_REPORT_DROPBOX_MEETING_PATH=/業務/打合せ完成
# Finder の「・」(全角中黒) と API の「･」(別コードポイント) が違うと not_found になる。スクリプトが「・」を自動変換します。
# Dropbox Business でチームフォルダだけ path/not_found になる場合の調整（通常は空で自動）
# TODO_REPORT_DROPBOX_ROOT_NAMESPACE_ID=
# TODO_REPORT_DROPBOX_USE_HOME_NAMESPACE=1
# 打合せ記録から抽出するタスク行の上限（既定 25）
# TODO_REPORT_MEETING_TASK_MAX=25
# TODO_REPORT_MAIL_IMAP_HOST=imap.gmail.com
# TODO_REPORT_MAIL_IMAP_PORT=993
# TODO_REPORT_MAIL_IMAP_SECURE=1
# TODO_REPORT_MAIL_IMAP_USER=your-mail@example.com
# TODO_REPORT_MAIL_IMAP_PASS=app-password-or-token
# iCloud では未指定時 LOGIN を使う（PLAIN 失敗回避）。上書き: LOGIN | PLAIN | AUTH=LOGIN
# TODO_REPORT_MAIL_IMAP_LOGIN_METHOD=
# TODO_REPORT_MAIL_IMAP_MAILBOX=INBOX
# TODO_REPORT_MAIL_IMAP_FETCH_LIMIT=100
# TODO_REPORT_MAIL_IMAP_LOOKBACK_DAYS=14
# 例: 4/1 以降を UID SEARCH で再走査（lastUid がある通常モードを上書き）— 試走し終わらしたら 0 か削除
# TODO_REPORT_MAIL_IMAP_USE_SEARCH=1
# TODO_REPORT_MAIL_IMAP_SINCE=2026-04-01
# 初回は巨大メールでパース失敗しやすいためデフォルト 10 分（ミリ秒）
# TODO_REPORT_MAIL_IMAP_SOCKET_TIMEOUT_MS=600000
# メール解析で件名スキップ（既定: config/todo-mail-analyze-skip.json）
# TODO_REPORT_MAIL_ANALYZE_SKIP_PATH=./config/todo-mail-analyze-skip.json
# カンマ区切りで追加可。未設定時は config/todo-mail-allowlist.json を読む
# TODO_REPORT_MAIL_ALLOWLIST=a@ex.com,b@ex.com
# TODO_REPORT_MAIL_ALLOWLIST_PATH=./config/todo-mail-allowlist.json
TODO_REPORT_PHONE_LOG_CSV_URL=https://docs.google.com/spreadsheets/d/1xdThHRlJ8rSv-HBJoVLK25qVxUzZ0nUUonQUnwPHG6k/export?format=csv&gid=0
